#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

resolve_node() {
  if [ -n "${NODE_BIN:-}" ] && [ -x "${NODE_BIN}" ]; then
    printf '%s\n' "$NODE_BIN"
    return 0
  fi
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  LAST_NODE=""
  for candidate in "$HOME"/.nvm/versions/node/*/bin/node /usr/local/bin/node /usr/bin/node; do
    if [ -x "$candidate" ]; then
      LAST_NODE="$candidate"
    fi
  done
  if [ -n "$LAST_NODE" ]; then
    printf '%s\n' "$LAST_NODE"
    return 0
  fi
  echo "agy-discord-channel: node executable not found (set NODE_BIN or add node to PATH)" >&2
  exit 1
}

NODE_EXE=$(resolve_node)
if [ -f "$PLUGIN_DIR/runtime/mcp-server.cjs" ]; then
  exec "$NODE_EXE" "$PLUGIN_DIR/runtime/mcp-server.cjs" "$@"
fi
exec "$NODE_EXE" "$PLUGIN_DIR/src/mcp-server.js" "$@"
